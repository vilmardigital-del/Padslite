rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pads/{padId} {
      // Todos podem ler os pads
      allow read: if true;
      
      // Apenas o vilmardigital@gmail.com pode criar, atualizar ou deletar
      allow write: if request.auth != null && request.auth.token.email == 'vilmardigital@gmail.com';
    }
  }
}
